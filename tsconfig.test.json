{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "emitDeclarationOnly": false,
        "declaration": false,
        "types": ["node"],
        "allowImportingTsExtensions": true
    },
    "include": [
        "lib/**/*",
        "test/**/*"
    ]
}
